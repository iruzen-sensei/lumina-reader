<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage: deliberately NO storage permissions. User file access
         (imports, backups) goes through the system picker (file_picker / SAF)
         and every path the app writes itself — Isar DB, downloads, cache —
         lives in app-scoped directories via path_provider. The previously
         declared MANAGE_EXTERNAL_STORAGE is a restricted permission that
         triggers Google Play review problems and was never requested at
         runtime anyway; the legacy READ/WRITE_EXTERNAL_STORAGE +
         requestLegacyExternalStorage entries were equally unused. -->

    <!-- Background service (for downloads - prevents HyperOS killing) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep screen on while reading -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Biometric auth -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="Lumina Reader"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:forceDarkAllowed="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumina" />
            </intent-filter>
        </activity>

        <!-- Background service for downloads -->
        <service
            android:name="id.flutter.background_service.AndroidBackgroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required for background service queries on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
</manifest>
